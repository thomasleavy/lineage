# Database (Supabase free tier or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lineage?schema=public"

# Auth: session secret (min 32 chars)
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# S3-compatible storage (MinIO for local, Supabase Storage or R2 for prod)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="lineage-assets"
S3_REGION="us-east-1"
S3_USE_SSL="false"

# Optional: Supabase (if using Supabase Auth/Storage instead of custom auth)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Sentry (free tier)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
